# MySQL — Nextest application database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nextest

# Optional: Staging DB for schema introspection (read-only)
STAGING_DB_HOST=
STAGING_DB_PORT=3306
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=

# Staging API base URL
STAGING_BASE_URL=https://api-stage.example.com/v1

# AI Context Generation (Required for auto-generating Request Bodies)
GEMINI_API_KEY=your_gemini_api_key_here

# Express server port
PORT=3001
